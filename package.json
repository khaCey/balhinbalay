{
  "name": "balhinbalay",
  "version": "1.0.0",
  "description": "Find Your Dream Home in Cebu",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.0",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^12.34.5",
    "http-proxy-middleware": "^2.0.6",
    "multer": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "concurrently \"craco start\" \"npm run server\"",
    "build": "craco build",
    "build:tunnel": "env-cmd -f .env.production craco build",
    "build:tunnel:clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && npm run build:tunnel",
    "test": "craco test",
    "eject": "react-scripts eject",
    "server": "cd server && node index.js",
    "tunnel": "cloudflared tunnel run balhinbalay",
    "migrate": "node server/run-migrations.js",
    "admin:set": "node server/set-admin.js",
    "seed-user": "node server/seed-user-listings.js",
    "email:sample": "node server/send-sample-email.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "env-cmd": "^10.1.0"
  }
}